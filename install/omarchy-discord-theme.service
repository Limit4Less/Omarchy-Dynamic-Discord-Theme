[Unit]
Description=Dynamically theme Discord to match the active Omarchy theme
Documentation=https://github.com/omarchy-users/omarchy-discord-theme
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-discord-theme watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
